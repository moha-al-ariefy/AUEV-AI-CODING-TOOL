<idea-plugin>
    <id>com.hackathon.aihelper</id>
    <name>AUEV AI Coding Tool</name>
    <vendor email="ma9802234@gmail.com">Solo Dev</vendor>

    <description><![CDATA[
    <b>AUEV AI Coding Tool</b> - Security-First pair programming suite for modern software engineering.<br><br>
    <b>Core v0.7 Capabilities:</b>
    <ul>
        <li><b>🛡️ SAST Security Audit & Scorecard:</b> Automated OWASP Top 10 + CWE vulnerability scanning with remediation blocks.</li>
        <li><b>🎯 STRIDE Threat Modeling:</b> Architectural threat boundary analysis and mitigation matrix.</li>
        <li><b>📦 Supply Chain & CVE Auditor:</b> Dependency manifest analysis, unpinned package alerts, and safe pin recommendations.</li>
        <li><b>🔒 Input Validation Shield:</b> Automated schema validation, defensive boundary assertions, and DTO contracts.</li>
        <li><b>🧹 Secret Sanitizer & Crypto Upgrades:</b> Intercepts hardcoded credentials and automatically upgrades weak crypto.</li>
        <li><b>🤖 Custom Model Registry:</b> Seamlessly choose from OpenAI, Anthropic, Groq, or register custom models (DeepSeek-R1, Qwen 2.5 Coder, Ollama, OpenRouter).</li>
        <li><b>👻 Smart Ghost Text:</b> Low-latency inline completion with strict security tripwires.</li>
    </ul>
    <em>Code fast, don't get hacked.</em>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="com.hackathon.aihelper.settings.AppSettingsState"/>

        <applicationConfigurable
                parentId="tools"
                instance="com.hackathon.aihelper.settings.AppSettingsConfigurable"
                id="com.hackathon.aihelper.AppSettingsConfigurable"
                displayName="AUEV AI Coding Tool"/>

        <toolWindow id="AI Assistant"
                    secondary="false"
                    anchor="right"
                    icon="AllIcons.General.ContextHelp"
                    factoryClass="com.hackathon.aihelper.ui.AIChatToolWindowFactory"/>

        <!--
             I updated this to 'postStartupActivity' which maps to ProjectActivity now.
             The old 'startupActivity' is discouraged in 2025.
        -->
        <postStartupActivity implementation="com.hackathon.aihelper.PluginStartup"/>
    </extensions>

    <actions>
        <action id="com.hackathon.aihelper.ApplyGhostAction"
                class="com.hackathon.aihelper.ApplyGhostAction"
                text="Apply AI Suggestion"
                description="Accepts the current ghost text because typing is hard">
            <keyboard-shortcut keymap="$default" first-keystroke="TAB"/>
            <add-to-group group-id="EditorActions" anchor="last"/>
        </action>

        <action id="com.hackathon.aihelper.ClearGhostAction"
                class="com.hackathon.aihelper.ClearGhostAction"
                text="Clear AI Suggestion"
                description="Banishes the ghost back to the void">
            <keyboard-shortcut keymap="$default" first-keystroke="ESCAPE"/>
        </action>
    </actions>
</idea-plugin>